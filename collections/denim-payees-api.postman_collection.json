      "name": "Payees",
      "description": {
        "content": "A payee is your contractor or carrier. They are the entity that needs to be paid for services. Payees are a type of Company in our ecosystem and are associated to our shared client through Client-Payee Relationships.",
        "type": "text/plain"
      },
